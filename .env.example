# Copy to .env.local and fill in. Never commit .env.local.
# Dev project only: production keys live in Vercel's settings.
# For the local stack, `supabase status -o env` prints these values.

# Postgres connection (server only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase, used for sign-in only (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
