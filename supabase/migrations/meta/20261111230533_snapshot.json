  "views": {
    "public.positions": {
      "columns": {
        "market_id": {
          "name": "market_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "member_id": {
          "name": "member_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "yes": {
          "name": "yes",
          "type": "numeric(32, 12)",
          "primaryKey": false,
          "notNull": true
        },
        "no": {
          "name": "no",
          "type": "numeric(32, 12)",
          "primaryKey": false,
          "notNull": true
        },
        "invested": {
          "name": "invested",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select market_id, member_id,\n      coalesce(sum(case when side = 'YES' then (case when kind = 'buy' then shares else -shares end) end), 0) as yes,\n      coalesce(sum(case when side = 'NO' then (case when kind = 'buy' then shares else -shares end) end), 0) as no,\n      sum(case when kind = 'buy' then coins else -coins end)::bigint as invested\n    from trades group by market_id, member_id",
      "name": "positions",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    }
  },
